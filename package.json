{
  "name": "natter-ecommerce-scraper",
  "version": "1.0.0",
  "description": "CLI scraper for the webscraper.io static e-commerce test site",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "scrape": "tsx src/cli.ts",
    "start:file": "tsx src/cli.ts output.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "bin": {
    "ecommerce-scraper": "./dist/cli.js"
  },
  "keywords": ["scraper", "ecommerce", "cli"],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
